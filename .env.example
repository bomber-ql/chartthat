# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，严禁提交。

# ---- LLM（DeepSeek，OpenAI 兼容；不配置则自动走启发式降级引擎）----
# 申请：https://platform.deepseek.com → API Keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- CORS（生产同源部署，收紧为本域名）----
CORS_ORIGINS=https://chartthat.com,https://www.chartthat.com
