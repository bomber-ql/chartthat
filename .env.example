# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，严禁提交。

# ---- LLM（DeepSeek，OpenAI 兼容；不配置则自动走启发式降级引擎）----
# 申请：https://platform.deepseek.com → API Keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- CORS（生产同源部署，收紧为本域名）----
CORS_ORIGINS=https://chartthat.com,https://www.chartthat.com

# ---- 使用统计（SPEC v1.19）：配置后可通过 /api/stats?token=<此值> 查看；留空则端点恒 404 ----
# 建议生成随机串：openssl rand -hex 16
STATS_TOKEN=

# ---- API 滥用防护（SPEC v1.24 §7.2）----
# 速率限制总开关：true（默认）/ false（仅排障时临时关闭）
RATE_LIMIT_ENABLED=true
# 请求体硬上限（字节），超限返回 413；默认 15MB（GIF 多帧 base64 需要较大余量）
MAX_REQUEST_BYTES=15728640
